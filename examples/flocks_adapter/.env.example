# SecRL Lite Flocks adapter -- example configuration.
# Copy to .env (never commit real values) or export in the runner shell.

# Flocks native API base URL. Must be plain http:// on a network the SecRL
# runner container can reach (the platform allowlists by host).
FLOCKS_BASE_URL=http://flocks.internal:3000

# Bearer token for Flocks. Injected into this adapter only; never forwarded
# to the SecRL platform, and never logged.
FLOCKS_API_TOKEN=change-me

# Dedicated tool-less Flocks agent used for evaluation turns (decision 1).
FLOCKS_EVAL_AGENT=secl-eval

# Explicit model per request (decision 4); changing either value changes the
# manifest version string, its SHA-256, and therefore the agent revision.
MODEL_PROVIDER_ID=anthropic
MODEL_ID=claude-sonnet-4-5

# Local listen port for this adapter.
ADAPTER_PORT=8091

# Set to false once the Flocks side confirms it does not expose per-message
# token stats; the manifest version then carries a "+no-usage" marker
# (decision 3).
FLOCKS_USAGE_REPORTED=true

# Polling of /api/session/{id}/status.
FLOCKS_POLL_INTERVAL_SECONDS=1.0
FLOCKS_POLL_TIMEOUT_SECONDS=300
